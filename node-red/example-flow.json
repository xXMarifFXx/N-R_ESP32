[
  {
    "id": "nb_tab",
    "type": "tab",
    "label": "N-R_ESP32 Demo",
    "disabled": false,
    "info": "Companion flow for the N-R_ESP32 library examples.\n\nBROKER: double-click any MQTT node, edit the 'HiveMQ Cloud' broker.\n1. Connection tab: Server = your cluster URL, Port 8883, tick 'Enable secure (SSL/TLS) connection'. Keep Client ID different from the ESP32's device name.\n2. Security tab: your HiveMQ username + password.\nFor a LOCAL broker instead: Port 1883 and untick TLS.\n\nDASHBOARD (2.0): this flow uses the '@flowfuse/node-red-dashboard' palette.\nInstall it via  Menu -> Manage palette -> Install -> @flowfuse/node-red-dashboard,\nthen Deploy and open  http://<node-red-host>:1880/dashboard"
  },
  {
    "id": "nb_broker",
    "type": "mqtt-broker",
    "name": "HiveMQ Cloud",
    "broker": "YOUR-CLUSTER.s1.eu.hivemq.cloud",
    "port": "8883",
    "clientid": "node-red",
    "usetls": true,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "nb_ui_base",
    "type": "ui-base",
    "name": "S&I ESP32 Dashboard",
    "path": "/dashboard",
    "appIcon": "",
    "includeClientData": true,
    "acceptsClientConfig": ["ui-notification", "ui-control"],
    "showPathInSidebar": false,
    "headerContent": "page",
    "navigationStyle": "default",
    "titleBarStyle": "default",
    "showReconnectNotification": true,
    "notificationDisplayTime": 1,
    "showDisconnectNotification": true
  },
  {
    "id": "nb_ui_theme",
    "type": "ui-theme",
    "name": "S&I Theme",
    "colors": {
      "surface": "#ffffff",
      "primary": "#7b1113",
      "bgPage": "#f5f5f5",
      "groupBg": "#ffffff",
      "groupOutline": "#d6d6d6"
    },
    "sizes": {
      "density": "default",
      "pagePadding": "12px",
      "groupGap": "12px",
      "groupBorderRadius": "6px",
      "widgetGap": "12px"
    }
  },
  {
    "id": "nb_ui_page",
    "type": "ui-page",
    "name": "ESP32",
    "ui": "nb_ui_base",
    "path": "/esp32",
    "icon": "home",
    "layout": "grid",
    "theme": "nb_ui_theme",
    "order": 1,
    "className": "",
    "visible": true,
    "disabled": false
  },
  {
    "id": "nb_grp_live",
    "type": "ui-group",
    "name": "Live Data",
    "page": "nb_ui_page",
    "width": "6",
    "height": "1",
    "order": 1,
    "showTitle": true,
    "className": "",
    "visible": true,
    "disabled": false,
    "groupType": "default"
  },
  {
    "id": "nb_grp_ctrl",
    "type": "ui-group",
    "name": "Controls",
    "page": "nb_ui_page",
    "width": "6",
    "height": "1",
    "order": 2,
    "showTitle": true,
    "className": "",
    "visible": true,
    "disabled": false,
    "groupType": "default"
  },
  {
    "id": "nb_in_all",
    "type": "mqtt in",
    "z": "nb_tab",
    "name": "ESP32 telemetry",
    "topic": "devices/esp32-demo/#",
    "qos": "0",
    "datatype": "auto",
    "broker": "nb_broker",
    "x": 160,
    "y": 100,
    "wires": [["nb_debug"]]
  },
  {
    "id": "nb_debug",
    "type": "debug",
    "z": "nb_tab",
    "name": "incoming",
    "active": true,
    "tosidebar": true,
    "complete": "true",
    "targetType": "full",
    "x": 420,
    "y": 100,
    "wires": []
  },
  {
    "id": "nb_in_temp",
    "type": "mqtt in",
    "z": "nb_tab",
    "name": "temperature",
    "topic": "devices/esp32-demo/temperature",
    "qos": "0",
    "datatype": "auto",
    "broker": "nb_broker",
    "x": 160,
    "y": 200,
    "wires": [["nb_ex_temp"]]
  },
  {
    "id": "nb_ex_temp",
    "type": "change",
    "z": "nb_tab",
    "name": "payload = value",
    "rules": [
      { "t": "set", "p": "payload", "pt": "msg", "to": "payload.value", "tot": "msg" }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 380,
    "y": 200,
    "wires": [["nb_gauge", "nb_chart"]]
  },
  {
    "id": "nb_gauge",
    "type": "ui-gauge",
    "z": "nb_tab",
    "group": "nb_grp_live",
    "order": 1,
    "width": 0,
    "height": 0,
    "name": "Temperature",
    "label": "Temperature",
    "icon": "",
    "prefix": "",
    "suffix": "",
    "unit": "°C",
    "gtype": "gauge-34",
    "gstyle": "needle",
    "min": 0,
    "max": 50,
    "sizeThickness": 16,
    "sizeGap": 8,
    "sizeKeyThickness": 8,
    "segments": [
      { "from": 0, "color": "#5cd65c" },
      { "from": 30, "color": "#e6e600" },
      { "from": 40, "color": "#ff3333" }
    ],
    "className": "",
    "x": 620,
    "y": 180,
    "wires": []
  },
  {
    "id": "nb_chart",
    "type": "ui-chart",
    "z": "nb_tab",
    "group": "nb_grp_live",
    "name": "Temp history",
    "label": "Temperature",
    "order": 2,
    "width": 0,
    "height": 0,
    "chartType": "line",
    "category": "topic",
    "categoryType": "msg",
    "xAxisProperty": "",
    "xAxisPropertyType": "timestamp",
    "xAxisType": "time",
    "xAxisFormat": "",
    "xAxisFormatType": "auto",
    "yAxisProperty": "payload",
    "action": "append",
    "stackSeries": false,
    "pointShape": "circle",
    "pointRadius": 3,
    "showLegend": false,
    "removeOlder": 10,
    "removeOlderUnit": "60",
    "removeOlderPoints": "",
    "interpolation": "linear",
    "colors": ["#7b1113", "#ff7f0e", "#2ca02c", "#d62728", "#9467bd"],
    "className": "",
    "x": 620,
    "y": 240,
    "wires": [[]]
  },
