[
  {
    "id": "nb_tab",
    "type": "tab",
    "label": "N-R_ESP32 Demo",
    "disabled": false,
    "info": "Companion flow for the N-R_ESP32 library examples.\n\nBROKER: double-click any MQTT node, edit the 'HiveMQ Cloud' broker.\n1. Connection tab: Server = your cluster URL, Port 8883, tick 'Enable secure (SSL/TLS) connection'. Keep Client ID different from the ESP32's device name.\n2. Security tab: your HiveMQ username + password.\nFor a LOCAL broker instead: Port 1883 and untick TLS.\n\nDASHBOARD: this flow uses the 'node-red-dashboard' palette.\nInstall it via  Menu -> Manage palette -> Install -> node-red-dashboard,\nthen Deploy and open  http://<node-red-host>:1880/ui"
  },
  {
    "id": "nb_broker",
    "type": "mqtt-broker",
    "name": "HiveMQ Cloud",
    "broker": "YOUR-CLUSTER.s1.eu.hivemq.cloud",
    "port": "8883",
    "clientid": "node-red",
    "usetls": true,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "nb_dash_tab",
    "type": "ui_tab",
    "name": "S&I ESP32",
    "icon": "dashboard",
    "order": 1,
    "disabled": false,
    "hidden": false
  },
  {
    "id": "nb_grp_live",
    "type": "ui_group",
    "name": "Live Data",
    "tab": "nb_dash_tab",
    "order": 1,
    "disp": true,
    "width": "6",
    "collapse": false,
    "className": ""
  },
  {
    "id": "nb_grp_ctrl",
    "type": "ui_group",
    "name": "Controls",
    "tab": "nb_dash_tab",
    "order": 2,
    "disp": true,
    "width": "6",
    "collapse": false,
    "className": ""
  },
  {
    "id": "nb_in_all",
    "type": "mqtt in",
    "z": "nb_tab",
    "name": "ESP32 telemetry",
    "topic": "devices/esp32-demo/#",
    "qos": "0",
    "datatype": "auto",
    "broker": "nb_broker",
    "x": 160,
    "y": 100,
    "wires": [["nb_debug"]]
  },
  {
    "id": "nb_debug",
    "type": "debug",
    "z": "nb_tab",
    "name": "incoming",
    "active": true,
    "tosidebar": true,
    "complete": "true",
    "targetType": "full",
    "x": 420,
    "y": 100,
    "wires": []
  },
  {
    "id": "nb_in_temp",
    "type": "mqtt in",
    "z": "nb_tab",
    "name": "temperature",
    "topic": "devices/esp32-demo/temperature",
    "qos": "0",
    "datatype": "auto",
    "broker": "nb_broker",
    "x": 160,
    "y": 200,
    "wires": [["nb_ex_temp"]]
  },
  {
    "id": "nb_ex_temp",
    "type": "change",
    "z": "nb_tab",
    "name": "payload = value",
    "rules": [
      { "t": "set", "p": "payload", "pt": "msg", "to": "payload.value", "tot": "msg" }
    ],
    "action": "",
    "property": "",
    "from": "",
    "to": "",
    "reg": false,
    "x": 380,
    "y": 200,
    "wires": [["nb_gauge", "nb_chart"]]
  },
  {
    "id": "nb_gauge",
    "type": "ui_gauge",
    "z": "nb_tab",
    "name": "Temperature",
    "group": "nb_grp_live",
    "order": 1,
    "width": 0,
    "height": 0,
    "gtype": "gage",
    "title": "Temperature",
    "label": "°C",
    "format": "{{value}}",
    "min": 0,
    "max": "50",
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": "",
    "seg2": "",
    "diff": false,
    "className": "",
    "x": 610,
    "y": 180,
    "wires": []
  },
  {
    "id": "nb_chart",
    "type": "ui_chart",
    "z": "nb_tab",
    "name": "Temp history",
    "group": "nb_grp_live",
    "order": 2,
    "width": 0,
    "height": 0,
    "label": "Temperature",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "waiting for data…",
    "dot": false,
    "ymin": "",
    "ymax": "",
    "removeOlder": "10",
    "removeOlderPoints": "",
    "removeOlderUnit": "60",
    "cutout": 0,
    "useOneColor": false,
    "useUTC": false,
    "colors": ["#1f77b4", "#aec7e8", "#ff7f0e", "#2ca02c", "#98df8a", "#d62728", "#ff9896", "#9467bd"],
    "outputs": 1,
    "useDifferentColor": false,
    "className": "",
    "x": 610,
    "y": 240,
    "wires": [[]]
  },
  {
    "id": "nb_in_status",
    "type": "mqtt in",
    "z": "nb_tab",
    "name": "status",
    "topic": "devices/esp32-demo/status",
    "qos": "0",
    "datatype": "auto",
    "broker": "nb_broker",
    "x": 150,
    "y": 300,
    "wires": [["nb_txt_status"]]
  },
  {
    "id": "nb_txt_status",
    "type": "ui_text",
    "z": "nb_tab",
    "group": "nb_grp_live",
    "order": 3,
    "width": 0,
    "height": 0,
    "name": "Status",
    "label": "Device",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "className": "",
    "x": 610,
    "y": 300,
    "wires": []
  },
  {
    "id": "nb_switch",
    "type": "ui_switch",
    "z": "nb_tab",
    "name": "LED",
    "label": "LED",
    "tooltip": "",
    "group": "nb_grp_ctrl",
    "order": 1,
    "width": 0,
    "height": 0,
    "passthru": true,
    "decouple": "false",
    "topic": "",
    "topicType": "str",
    "style": "",
    "onvalue": "on",
    "onvalueType": "str",
    "onicon": "",
    "oncolor": "",
    "offvalue": "off",
    "offvalueType": "str",
    "officon": "",
    "offcolor": "",
    "animate": false,
    "className": "",
    "x": 330,
    "y": 420,
    "wires": [["nb_led_out"]]
  },
  {
    "id": "nb_slider",
    "type": "ui_slider",
    "z": "nb_tab",
    "name": "Threshold",
    "label": "Threshold °C",
    "tooltip": "",
    "group": "nb_grp_ctrl",
    "order": 2,
    "width": 0,
    "height": 0,
    "passthru": true,
    "outs": "end",
    "topic": "",
    "topicType": "str",
    "min": "0",
    "max": "50",
    "step": 1,
    "className": "",
    "x": 340,
    "y": 480,
    "wires": [["nb_thr_out"]]
  },
  {
    "id": "nb_led_out",
    "type": "mqtt out",
    "z": "nb_tab",
    "name": "led/set",
    "topic": "devices/esp32-demo/led/set",
    "qos": "0",
    "retain": "false",
    "broker": "nb_broker",
    "x": 600,
    "y": 420,
    "wires": []
  },
  {
    "id": "nb_thr_out",
    "type": "mqtt out",
    "z": "nb_tab",
    "name": "threshold/set",
    "topic": "devices/esp32-demo/threshold/set",
    "qos": "0",
    "retain": "false",
    "broker": "nb_broker",
    "x": 610,
    "y": 480,
    "wires": []
  },
  {
    "id": "nb_led_on",
    "type": "inject",
    "z": "nb_tab",
    "name": "LED on (test)",
    "props": [{ "p": "payload" }],
    "payload": "on",
    "payloadType": "str",
    "x": 160,
    "y": 580,
    "wires": [["nb_led_out"]]
  },
  {
    "id": "nb_led_off",
    "type": "inject",
    "z": "nb_tab",
    "name": "LED off (test)",
    "props": [{ "p": "payload" }],
    "payload": "off",
    "payloadType": "str",
    "x": 160,
    "y": 620,
    "wires": [["nb_led_out"]]
  }
]
